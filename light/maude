#!/bin/bash
# maude - Quick project launcher for Claude Code
# Usage:
#   maude project-name   Create/open a project and launch Claude Code
#   maude tui            Interactive project launcher (Textual UI)
#   maude web            Launch kanna web UI (installs Chromium if needed)
#   maude github         Wizard for GitHub identity, SSH/GPG keys, signing
#   maude update         Update Claude Code, the maude TUI, and kanna
#   maude list           Show all available projects
#   maude delete <name>  Move a project to Projects/.deleted (with confirmation)
#   maude help           Show this help message
#
# Tab completion: type "maude ban<Tab>" to auto-complete project names

PROJECTS_DIR="$HOME/Maude/Projects"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[1;36m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

# ── Help ──────────────────────────────────────────────────────────────
show_help() {
    echo ""
    echo -e "${BOLD}maude${NC} - Quick project launcher for Claude Code"
    echo ""
    echo -e "  ${CYAN}maude project-name${NC}        Open a project (creates it if it doesn't exist)"
    echo -e "  ${CYAN}maude list${NC}                Show all available projects"
    echo -e "  ${CYAN}maude delete <name>${NC}       Delete a project (moves to .deleted/)"
    echo -e "  ${CYAN}maude tui${NC}                 Interactive project launcher (experimental)"
    echo -e "  ${CYAN}maude web${NC}                 Launch web UI (kanna, experimental)"
    echo -e "  ${CYAN}maude github${NC}              Wizard for Git/SSH/GPG (Textual UI)"
    echo -e "  ${CYAN}maude update${NC}              Update Claude Code, the maude TUI, and kanna"
    echo -e "  ${CYAN}maude help${NC}                Show this help message"
    echo ""
    echo "Examples:"
    echo "  maude banana       Open or create the 'banana' project"
    echo "  maude my-app       Open or create the 'my-app' project"
    echo "  maude list         See what projects you have"
    echo ""
    echo "Tab completion:"
    echo "  Type  maude ban<Tab>  to auto-complete to 'banana'"
    echo ""
    echo "Projects are stored in: $PROJECTS_DIR"
    echo ""
}

# ── List projects ─────────────────────────────────────────────────────
list_projects() {
    # Make sure the Projects folder exists
    mkdir -p "$PROJECTS_DIR"

    # Collect project directories
    local projects=()
    for d in "$PROJECTS_DIR"/*/; do
        [[ -d "$d" ]] || continue
        projects+=("$(basename "$d")")
    done

    if [[ ${#projects[@]} -eq 0 ]]; then
        echo ""
        echo -e "${YELLOW}No projects yet!${NC}"
        echo ""
        echo "Create your first project by running:"
        echo ""
        echo "  maude my-first-project"
        echo ""
        return
    fi

    echo ""
    echo -e "${BOLD}Your projects:${NC}"
    echo ""
    for name in "${projects[@]}"; do
        local path="$PROJECTS_DIR/$name"
        if [[ -d "$path/.git" ]]; then
            echo -e "  ${GREEN}$name${NC}"
        else
            echo -e "  ${YELLOW}$name${NC}  (no git repo)"
        fi
    done
    echo ""
    echo "Open any project with:  maude project-name"
    echo ""
}

# ── Delete project ────────────────────────────────────────────────────
delete_project() {
    local name="$1"

    if [[ -z "$name" ]]; then
        echo -e "${RED}Error: Please specify a project name.${NC}" >&2
        echo "" >&2
        echo "Usage:  maude delete <project-name>" >&2
        exit 1
    fi

    local path="$PROJECTS_DIR/$name"
    local deleted_dir="$PROJECTS_DIR/.deleted"

    if [[ ! -d "$path" ]]; then
        echo -e "${RED}Error: Project '$name' does not exist.${NC}" >&2
        exit 1
    fi

    echo ""
    echo -e "${YELLOW}Are you sure you want to delete project '${BOLD}$name${NC}${YELLOW}'?${NC}"
    echo -e "  (It will be moved to ${CYAN}$deleted_dir/$name${NC})"
    echo ""
    read -r -p "Type yes or no: " answer

    case "$answer" in
        [Yy]|[Yy][Ee][Ss])
            mkdir -p "$deleted_dir"
            # If a previously deleted version exists, remove it first
            if [[ -d "$deleted_dir/$name" ]]; then
                rm -rf "$deleted_dir/$name"
            fi
            mv "$path" "$deleted_dir/$name"
            echo ""
            echo -e "${GREEN}Project '$name' moved to .deleted/${NC}"
            echo ""
            ;;
        *)
            echo ""
            echo -e "${CYAN}Delete cancelled.${NC}"
            echo ""
            ;;
    esac
}

# ── Launch TUI ────────────────────────────────────────────────────────
MAUDE_PY="$HOME/.local/bin/maude.py"
# GitHub raw URL — overridable for testing forks (e.g. MAUDE_RAW=...)
GH_RAW="${MAUDE_RAW:-https://raw.githubusercontent.com/dirkpetersen/maude/main/light}"
MAUDE_PY_URL="$GH_RAW/maude.py"
MAUDE_BIN_URL="$GH_RAW/maude"
MAUDE_LIB_DIR="$HOME/.local/lib/maude"

# Pin: keep in sync with light/maude-bootstrap.sh's kanna-code install line.
KANNA_PKG="kanna-code@0.63.0"

# Inline minimal fallback used if the lib download fails. Mirrors
# ensure-tools.sh so node/python/etc. still get linked when offline.
_inline_ensure_tool_symlinks() {
    local bin="$HOME/.local/bin"
    mkdir -p "$bin"
    [[ -x "$HOME/.bun/bin/bun"   ]] && ln -sfn "$HOME/.bun/bin/bun"   "$bin/bun"
    [[ -x "$HOME/.bun/bin/kanna" ]] && ln -sfn "$HOME/.bun/bin/kanna" "$bin/kanna"
    local _py _pip
    _py=$(command -v python3 2>/dev/null)
    _pip=$(command -v pip3 2>/dev/null)
    [[ -x "$_py"  ]] && ln -sfn "$_py"  "$bin/python"
    [[ -x "$_pip" ]] && ln -sfn "$_pip" "$bin/pip"
    local nvm_dir="${NVM_DIR:-$HOME/.nvm}"
    if [[ -d "$nvm_dir/versions/node" ]]; then
        local nb; nb=$(ls -td "$nvm_dir/versions/node"/*/bin 2>/dev/null | head -1)
        if [[ -n "$nb" ]]; then
            local t
            for t in node npm npx; do
                [[ -x "$nb/$t" ]] && ln -sfn "$nb/$t" "$bin/$t"
            done
        fi
    fi
}

# Source a cached library file from $MAUDE_LIB_DIR; download on first use.
# Returns 0 on success, 1 if the file couldn't be obtained.
load_lib() {
    local name="$1"
    local lib="$MAUDE_LIB_DIR/$name"
    if [[ ! -f "$lib" ]]; then
        mkdir -p "$MAUDE_LIB_DIR"
        curl -fsSL --max-time 10 "$GH_RAW/lib/$name" -o "$lib" 2>/dev/null || return 1
    fi
    # shellcheck source=/dev/null
    . "$lib"
}

load_lib ensure-tools.sh || ensure_tool_symlinks() { _inline_ensure_tool_symlinks; }
load_lib refresh-md.sh   || true   # refresh_claude_md falls through if not loaded
load_lib update-skills.sh || true
load_lib kanna.sh || true

# Pin rationale: 8.2.3 (and only 8.2.3) crashes the Set Creds modal with
# KeyError 'text-area--gutter' (textual#6528); every other 8.x is verified
# fine against maude.py. <9 shields auto-updating end-user machines from an
# unknown future major-version break.
TEXTUAL_PIN='textual>=8.2.4,<9'

_pip_install_textual() {
    pip install --quiet --break-system-packages "$TEXTUAL_PIN" 2>/dev/null && return 0
    pip install --quiet "$TEXTUAL_PIN" 2>/dev/null && return 0
    return 1
}

ensure_textual() {
    if ! python3 -c "import textual" 2>/dev/null; then
        echo -e "${CYAN}Installing textual...${NC}"
        _pip_install_textual || {
            echo -e "${RED}Failed to install textual — TUI will not work.${NC}" >&2
            return 1
        }
        return 0
    fi
    # Already installed — reinstall only if the version is outside the pin:
    # anything below 8.2.4 (including the old <8 pin era) or 9+.
    local ver
    ver=$(python3 -c 'import textual,sys; sys.stdout.write(textual.__version__)' 2>/dev/null)
    case "$ver" in
        8.2.[4-9]*|8.2.[1-9][0-9]*|8.[3-9].*|8.[1-9][0-9]*.*)
            ;;  # inside the pin — nothing to do
        *)
            echo -e "${YELLOW}Reinstalling textual ($ver → $TEXTUAL_PIN) to avoid a known crash...${NC}"
            _pip_install_textual || {
                echo -e "${RED}Failed to reinstall textual — TUI may crash.${NC}" >&2
                return 1
            }
            ;;
    esac
    return 0
}

maude_maybe_update() {
    local stamp="$HOME/.local/share/maude/.last-maude-update"
    local now
    now=$(date +%s)
    local last=0
    if [[ -f "$stamp" ]]; then
        last=$(cat "$stamp" 2>/dev/null || echo 0)
    fi
    local week=$((7 * 24 * 60 * 60))
    if [[ $((now - last)) -ge $week ]]; then
        echo -e "${CYAN}Running weekly maude update...${NC}"
        mkdir -p "$(dirname "$stamp")"
        echo "$now" > "$stamp"
        update_all
    fi
}

# ── Purge stale Python bytecache for maude.py ────────────────────────
purge_pycache() {
    rm -rf "$(dirname "$MAUDE_PY")/__pycache__" 2>/dev/null || true
}

launch_tui() {
    ensure_textual

    # First-time bootstrap: fetch maude.py if it isn't on disk yet.
    # Daily refresh is handled inside maude.py itself (fires after noon).
    if [[ ! -f "$MAUDE_PY" ]]; then
        echo -e "${CYAN}Downloading maude TUI...${NC}"
        mkdir -p "$(dirname "$MAUDE_PY")"
        curl -fsSL "${MAUDE_PY_URL}?cache=$(date +%s)" -o "$MAUDE_PY" || {
            echo -e "${RED}Error: could not download maude.py${NC}" >&2
            exit 1
        }
    fi

    maude_maybe_update
    purge_pycache
    # Exit code 42 = "Reload UI" was clicked after an update. Re-exec with
    # the freshly downloaded maude.py so the user gets the new version without
    # returning to the shell. Any other exit code breaks out of the loop.
    local _tui_rc
    while true; do
        python3 "$MAUDE_PY"
        _tui_rc=$?
        [[ $_tui_rc -eq 42 ]] || break
        purge_pycache
        echo -e "${CYAN}Reloading UI with updated version...${NC}"
    done
    echo ""
    echo -e "  Please type ${BOLD}menu${NC} <Enter> to get back to the TUI or type ${BOLD}maude help${NC} <Enter>"
    echo ""
}

# ── Update everything: maude CLI, Claude Code, the maude TUI, kanna ───
update_all() {
    local ts rc=0
    ts=$(date +%s)

    # Update the maude CLI first. Linux/bash keeps the running script's open
    # inode valid across rename(2), so the current invocation can safely mv a
    # new version over itself mid-run. Rather than stopping there and making
    # the user run 'maude update' a second time to actually execute the new
    # code, re-exec into the freshly written file immediately: same PID, same
    # terminal, `update_all` picks up right where the old process left off,
    # but running the NEW script — so one `maude update` fully converges.
    # _MAUDE_UPDATE_STAGE2 guards against re-exec'ing more than once even if
    # something odd happens downstream (e.g. a second update triggered mid-run).
    if [[ "${_MAUDE_UPDATE_STAGE2:-0}" != "1" ]]; then
        echo -e "${BOLD}Updating the maude CLI...${NC}"
        local self_path tmp_path
        self_path=$(realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "$HOME/.local/bin/maude")
        tmp_path="${self_path}.new.$$"
        if curl -fsSL "${MAUDE_BIN_URL}?cache=${ts}" -o "$tmp_path"; then
            # Sanity check: must look like a non-trivial bash script.
            if head -n1 "$tmp_path" | grep -q '^#!/bin/bash' && [[ $(wc -c < "$tmp_path") -gt 1024 ]]; then
                chmod +x "$tmp_path"
                if diff -q "$tmp_path" "$self_path" >/dev/null 2>&1; then
                    # Already current — nothing to re-exec into.
                    rm -f "$tmp_path"
                    echo -e "${GREEN}  ✓ maude wrapper already up to date${NC}"
                elif mv "$tmp_path" "$self_path"; then
                    echo -e "${GREEN}  ✓ maude wrapper updated — continuing this update with the new version...${NC}"
                    echo ""
                    _MAUDE_UPDATE_STAGE2=1 exec "$self_path" update
                    # Only reached if exec itself failed to launch the new
                    # binary (e.g. permissions) — fall back to finishing this
                    # run with the OLD code, same as before this change.
                    echo -e "${YELLOW}  ✗ could not switch to the updated wrapper — finishing with the old version (run 'maude update' again to pick up the rest)${NC}"
                    rc=1
                else
                    rm -f "$tmp_path"
                    echo -e "${YELLOW}  ✗ could not replace $self_path${NC}"
                    rc=1
                fi
            else
                rm -f "$tmp_path"
                echo -e "${YELLOW}  ✗ downloaded wrapper failed sanity check${NC}"
                rc=1
            fi
        else
            rm -f "$tmp_path"
            echo -e "${YELLOW}  ✗ could not fetch maude wrapper${NC}"
            rc=1
        fi
        echo ""
    else
        echo -e "${CYAN}Continuing update with the newly downloaded maude wrapper...${NC}"
        echo ""
    fi
    # Don't let this leak into child processes spawned below (claude update,
    # npm, etc.) — it has done its job of preventing a repeat re-exec.
    unset _MAUDE_UPDATE_STAGE2

    # ── Migrate the claude wrapper to ~/bin/claude-wrapper.sh ────────────
    # Older sandboxes installed it under ~/.local/bin, which breaks the
    # wrapper's own self-update (it writes to ~/bin/claude-wrapper.sh — a path
    # ~/bin/claude did not point to). Relocate + relink so self-update works,
    # validating any file before trusting it so a truncated/partial wrapper
    # can never replace a working one.
    echo -e "${BOLD}Checking claude wrapper location...${NC}"
    local _oldw="$HOME/.local/bin/claude-wrapper.sh"
    local _neww="$HOME/bin/claude-wrapper.sh"
    local _wrapper_url="https://raw.githubusercontent.com/dirkpetersen/dok/main/scripts/claude-wrapper.sh"
    # A real wrapper is a ~40KB bash script; guard against empty/truncated files.
    _wrapper_valid() {
        [[ -s "$1" ]] || return 1
        head -n1 "$1" 2>/dev/null | grep -q '^#!' || return 1
        [[ $(wc -c < "$1" 2>/dev/null || echo 0) -gt 1024 ]]
    }
    mkdir -p "$HOME/bin"
    if [[ -f "$_oldw" ]]; then
        if [[ ! -e "$_neww" ]]; then
            # Only the old copy exists (the running wrapper — known good): move it.
            if mv "$_oldw" "$_neww"; then
                chmod +x "$_neww" 2>/dev/null
                ln -sfn claude-wrapper.sh "$HOME/bin/claude"
                echo -e "${GREEN}  ✓ moved wrapper to ~/bin/claude-wrapper.sh and relinked ~/bin/claude${NC}"
            else
                echo -e "${YELLOW}  ✗ could not move wrapper to ~/bin (left as-is)${NC}"
                rc=1
            fi
        elif _wrapper_valid "$_neww"; then
            # Both present and the correct-path copy is valid: prefer it.
            chmod +x "$_neww" 2>/dev/null
            ln -sfn claude-wrapper.sh "$HOME/bin/claude"
            rm -f "$_oldw"
            echo -e "${GREEN}  ✓ relinked ~/bin/claude to ~/bin/claude-wrapper.sh; removed stale ~/.local/bin copy${NC}"
        else
            # Correct-path copy is invalid/truncated: the old copy wins.
            if mv -f "$_oldw" "$_neww"; then
                chmod +x "$_neww" 2>/dev/null
                ln -sfn claude-wrapper.sh "$HOME/bin/claude"
                echo -e "${GREEN}  ✓ replaced an invalid ~/bin/claude-wrapper.sh with the working copy and relinked${NC}"
            else
                echo -e "${YELLOW}  ✗ could not repair ~/bin/claude-wrapper.sh${NC}"
                rc=1
            fi
        fi
    fi
    # Self-heal: if there's still no valid wrapper at the correct path (e.g. no
    # old copy AND a dangling ~/bin/claude or a partial ~/bin/claude-wrapper.sh),
    # re-fetch a fresh one. Best-effort — the wrapper also self-updates.
    if ! _wrapper_valid "$_neww"; then
        local _wt; _wt=$(mktemp)
        if curl -fsSL --max-time 20 "${_wrapper_url}?cache=${ts}" -o "$_wt" && _wrapper_valid "$_wt"; then
            if mv "$_wt" "$_neww"; then
                chmod +x "$_neww" 2>/dev/null
                ln -sfn claude-wrapper.sh "$HOME/bin/claude"
                echo -e "${GREEN}  ✓ installed a fresh claude wrapper at ~/bin/claude-wrapper.sh${NC}"
            else
                rm -f "$_wt"
                echo -e "${YELLOW}  ✗ could not install the fresh claude wrapper${NC}"
                rc=1
            fi
        else
            rm -f "$_wt"
            echo -e "${YELLOW}  ✗ no valid claude wrapper present and re-fetch failed (kept existing)${NC}"
            rc=1
        fi
    elif [[ ! -f "$_oldw" ]]; then
        # $_neww is valid, but the ~/bin/claude symlink could still be dangling
        # or wrong (e.g. a prior migration killed between the mv and the ln) —
        # ensure it points at the wrapper before reporting OK.
        [[ "$(readlink "$HOME/bin/claude" 2>/dev/null)" == "claude-wrapper.sh" ]] \
            || ln -sfn claude-wrapper.sh "$HOME/bin/claude"
        echo -e "${GREEN}  ✓ claude wrapper location OK${NC}"
    fi
    echo ""

    # ── Kick off independent, network-bound updates in parallel ─────────
    # Each job writes to its own capture file, but two resources are shared
    # and guarded by locks in the libs: (1) ~/.bashrc — codex.sh and grok.sh
    # both run a vendor installer that appends a PATH block and then strip it
    # back out, so they serialize their whole install+strip on ~/.bashrc.lock
    # (fd 200); (2) the bun/npm global package store — kanna, gemini, opencode
    # and the codex/grok npm fallbacks serialize their installs on
    # ~/.maude-pkg-install.lock (fd 9). Deliberately NOT parallelized:
    # mom upgrade -y (the Ubuntu package manager step, further below) —
    # apt/dpkg operations don't compose safely with concurrent runs and always
    # run solo.
    declare -A JPID=() JRC=() JOUT=() JERR=()
    local _eline
    # Per-job stdout/stderr capture files. Cleaned up with `rm -f` at the
    # single return below — no temp directory (so nothing here can become a
    # recursive delete) and no RETURN trap (bash fires RETURN on every
    # `.`/source too, which would wipe these mid-run).
    _alloc_job() {
        # Fall back to a deterministic path if mktemp fails (e.g. /tmp full) so
        # the job's redirect never becomes `> ""` — that would misattribute the
        # mktemp failure to the component being updated.
        JOUT[$1]=$(mktemp "${TMPDIR:-/tmp}/maude-update.XXXXXX" 2>/dev/null) \
            || JOUT[$1]="${TMPDIR:-/tmp}/maude-update.$$.$1.out"
        JERR[$1]=$(mktemp "${TMPDIR:-/tmp}/maude-update.XXXXXX" 2>/dev/null) \
            || JERR[$1]="${TMPDIR:-/tmp}/maude-update.$$.$1.err"
    }

    echo -e "${BOLD}Starting parallel updates (Claude Code, statusline, maude TUI, kanna, libraries)...${NC}"
    echo ""

    _alloc_job claude
    ( if command -v claude >/dev/null 2>&1; then
          claude update
      else
          echo "claude is not installed; skipping"
          exit 1
      fi
    ) > "${JOUT[claude]}" 2>&1 &
    JPID[claude]=$!

    _alloc_job statusline
    ( statusline="$HOME/.claude/statusline.sh"
      statusline_tmp=$(mktemp)
      if curl -fsSL --max-time 10 "$GH_RAW/statusline.sh?cache=${ts}" -o "$statusline_tmp" \
         && head -n1 "$statusline_tmp" | grep -q '^#!/bin/bash' \
         && grep -q 'context_window' "$statusline_tmp"; then
          chmod +x "$statusline_tmp"
          mv "$statusline_tmp" "$statusline"
      else
          rm -f "$statusline_tmp"
          echo "statusline download missing or invalid (kept existing copy)"
          exit 1
      fi
    ) > "${JOUT[statusline]}" 2>&1 &
    JPID[statusline]=$!

    _alloc_job maudepy
    ( mkdir -p "$(dirname "$MAUDE_PY")"
      if curl -fsSL "${MAUDE_PY_URL}?cache=${ts}" -o "$MAUDE_PY"; then
          # Mark today's daily-update stamp so maude.py's own self-update
          # doesn't re-fetch on the next launch.
          date +%Y-%m-%d > "$HOME/.maude-tui-last-update"
          # Purge stale bytecache so Python executes the new source immediately.
          rm -rf "$(dirname "$MAUDE_PY")/__pycache__"
      else
          echo "could not fetch maude.py"
          exit 1
      fi
    ) > "${JOUT[maudepy]}" 2>&1 &
    JPID[maudepy]=$!

    _alloc_job kanna
    ( if command -v bun >/dev/null 2>&1; then
          # flock serializes global package installs across the concurrent
          # `maude update` jobs (bun/npm share a global store).
          ( flock -w 600 9 2>/dev/null || true; bun install -g "$KANNA_PKG" ) 9>"$HOME/.maude-pkg-install.lock"
      else
          echo "bun is not installed; skipping kanna update"
          exit 1
      fi
    ) > "${JOUT[kanna]}" 2>&1 &
    JPID[kanna]=$!

    mkdir -p "$MAUDE_LIB_DIR"
    _alloc_job libs
    ( lib_rc=0
      for lib in ensure-tools.sh refresh-md.sh update-skills.sh gemini.sh llm-mode.sh codex.sh opencode.sh grok.sh kanna.sh; do
          lib_tmp=$(mktemp)
          if curl -fsSL --max-time 10 "$GH_RAW/lib/$lib?cache=${ts}" -o "$lib_tmp" \
             && [[ -s "$lib_tmp" ]] && grep -q '^[a-z_]*()' "$lib_tmp"; then
              mv "$lib_tmp" "$MAUDE_LIB_DIR/$lib"
          else
              rm -f "$lib_tmp"
              echo "could not fetch $lib (kept cached copy)"
              lib_rc=1
          fi
      done
      exit $lib_rc
    ) > "${JOUT[libs]}" 2>&1 &
    JPID[libs]=$!

    # The reviewer-CLI jobs below need update_gemini/update_codex/etc, which
    # live in the libs just fetched — wait for that ONE job. The other jobs
    # started above keep running in the background regardless.
    wait "${JPID[libs]}"; JRC[libs]=$?

    # Re-source the freshly-downloaded copies (or the prior cached ones, if
    # the fetch above failed) so this shell — and the jobs about to launch —
    # see the latest functions.
    # shellcheck source=/dev/null
    . "$MAUDE_LIB_DIR/ensure-tools.sh" 2>/dev/null || true
    # shellcheck source=/dev/null
    . "$MAUDE_LIB_DIR/refresh-md.sh"   2>/dev/null || true
    # shellcheck source=/dev/null
    . "$MAUDE_LIB_DIR/update-skills.sh" 2>/dev/null || true
    # shellcheck source=/dev/null
    . "$MAUDE_LIB_DIR/gemini.sh" 2>/dev/null || true
    # shellcheck source=/dev/null
    . "$MAUDE_LIB_DIR/kanna.sh" 2>/dev/null || true
    # llm-mode.sh must load before the per-tool reviewer libs (shared helpers).
    # shellcheck source=/dev/null
    . "$MAUDE_LIB_DIR/llm-mode.sh" 2>/dev/null || true
    # shellcheck source=/dev/null
    . "$MAUDE_LIB_DIR/codex.sh" 2>/dev/null || true
    # shellcheck source=/dev/null
    . "$MAUDE_LIB_DIR/opencode.sh" 2>/dev/null || true
    # shellcheck source=/dev/null
    . "$MAUDE_LIB_DIR/grok.sh" 2>/dev/null || true

    if declare -F update_skills >/dev/null; then
        _alloc_job skills
        ( update_skills ) > "${JOUT[skills]}" 2> "${JERR[skills]}" &
        JPID[skills]=$!
    fi
    if declare -F update_gemini >/dev/null; then
        _alloc_job gemini
        ( update_gemini ) > "${JOUT[gemini]}" 2> "${JERR[gemini]}" &
        JPID[gemini]=$!
    fi
    local _rtool
    for _rtool in codex opencode grok; do
        if declare -F "update_${_rtool}" >/dev/null; then
            _alloc_job "$_rtool"
            ( "update_${_rtool}" ) > "${JOUT[$_rtool]}" 2> "${JERR[$_rtool]}" &
            JPID[$_rtool]=$!
        fi
    done
    unset _rtool

    local _jname
    for _jname in "${!JPID[@]}"; do
        [[ -n "${JRC[$_jname]+x}" ]] && continue   # libs already waited on above
        wait "${JPID[$_jname]}"; JRC[$_jname]=$?
    done
    unset _jname

    # ── Print results, in the same order the old sequential run used ────
    echo -e "${BOLD}Updating Claude Code...${NC}"
    if [[ "${JRC[claude]:-1}" -eq 0 ]]; then
        cat "${JOUT[claude]}"
    else
        echo -e "${YELLOW}  Claude Code update failed${NC}"
        [[ -s "${JOUT[claude]}" ]] && cat "${JOUT[claude]}"
        rc=1
    fi
    echo ""

    echo -e "${BOLD}Refreshing statusline.sh...${NC}"
    if [[ "${JRC[statusline]:-1}" -eq 0 ]]; then
        echo -e "${GREEN}  ✓ statusline.sh updated${NC}"
    else
        echo -e "${YELLOW}  ✗ $(cat "${JOUT[statusline]}")${NC}"
        rc=1
    fi
    echo ""

    echo -e "${BOLD}Refreshing maude libraries (ensure-tools, refresh-md, update-skills, reviewers)...${NC}"
    if [[ "${JRC[libs]:-1}" -eq 0 ]]; then
        echo -e "${GREEN}  ✓ libraries refreshed${NC}"
    else
        local _l
        while IFS= read -r _l; do [[ -n "$_l" ]] && echo -e "${YELLOW}  ✗ $_l${NC}"; done < "${JOUT[libs]}"
        rc=1
    fi
    echo ""

    echo -e "${BOLD}Updating the Maude TUI (maude.py)...${NC}"
    if [[ "${JRC[maudepy]:-1}" -eq 0 ]]; then
        echo -e "${GREEN}  ✓ maude.py refreshed${NC}"
    else
        echo -e "${YELLOW}  ✗ $(cat "${JOUT[maudepy]}")${NC}"
        rc=1
    fi
    echo ""

    echo -e "${BOLD}Refreshing the login welcome (welcome.sh)...${NC}"
    local welcome_dst="$MAUDE_LIB_DIR/welcome.sh"
    local welcome_tmp="$welcome_dst.new.$$"
    mkdir -p "$MAUDE_LIB_DIR"
    if curl -fsSL --max-time 10 "$GH_RAW/welcome.sh?cache=${ts}" -o "$welcome_tmp" \
       && [[ -s "$welcome_tmp" ]] && grep -q 'MAUDE_WELCOMED' "$welcome_tmp"; then
        mv "$welcome_tmp" "$welcome_dst"
        echo -e "${GREEN}  ✓ welcome.sh refreshed${NC}"
    else
        rm -f "$welcome_tmp"
        echo -e "${YELLOW}  ✗ welcome.sh download missing or invalid (kept existing copy)${NC}"
        rc=1
    fi
    if [[ -f /etc/profile.d/maude-welcome.sh ]] \
       && ! grep -q '\.local/lib/maude/welcome\.sh' /etc/profile.d/maude-welcome.sh 2>/dev/null; then
        echo -e "${YELLOW}  Note: your login still uses the old welcome script; the refresh above won't${NC}"
        echo -e "${YELLOW}  show until the one-time stub is installed as root. From Windows PowerShell:${NC}"
        echo -e "${CYAN}    wsl -d Maude -u root -- bash -c 'rm -f /tmp/maude-welcome-stub.sh && curl -fsSL --max-time 20 https://raw.githubusercontent.com/dirkpetersen/maude/main/light/welcome-stub.sh -o /tmp/maude-welcome-stub.sh && grep -q .local/lib/maude/welcome.sh /tmp/maude-welcome-stub.sh && install -m 644 /tmp/maude-welcome-stub.sh /etc/profile.d/maude-welcome.sh'${NC}"
    fi
    echo ""

    # Ensure key env vars are in ~/.bashrc so they apply to every shell,
    # including cases where profile.d is not re-sourced on existing installs.
    echo -e "${BOLD}Checking shell environment exports...${NC}"
    local changed=0
    local ev
    for ev in \
        "export COLORTERM=truecolor" \
        "export PYTHONDONTWRITEBYTECODE=1" \
        "export GEMINI_CLI_TRUST_WORKSPACE=true"; do
        local key; key=$(echo "$ev" | grep -oP 'export \K[A-Z_]+')
        if ! grep -q "export ${key}=" "$HOME/.bashrc" 2>/dev/null; then
            printf '\n%s\n' "$ev" >> "$HOME/.bashrc"
            # Apply to current session immediately.
            eval "$ev"
            changed=$((changed + 1))
        fi
    done
    if [[ $changed -gt 0 ]]; then
        echo -e "${GREEN}  ✓ added $changed export(s) to ~/.bashrc${NC}"
    else
        echo -e "${GREEN}  ✓ shell exports already present${NC}"
    fi
    echo ""

    # Repair the orphan-fi artefact in ~/.bashrc left by an older buggy
    # `maude github` step 4. Uses the now-refreshed maude.py.
    echo -e "${BOLD}Checking ~/.bashrc for stale keychain artefacts...${NC}"
    if [[ -f "$MAUDE_PY" ]]; then
        python3 "$MAUDE_PY" --fix-bashrc || rc=1
    else
        echo -e "${YELLOW}  maude.py not on disk; skipping${NC}"
    fi
    echo ""

    # Self-heal the "Failed to start the systemd user session" cold-start
    # warning: bootstraps older than 77bf426 masked user@.service. Unmasking
    # needs root, which the sandbox user doesn't have — fix what we can and
    # print the exact root one-liner otherwise.
    echo -e "${BOLD}Checking systemd user session health...${NC}"
    local session_ok=1
    if [[ "$(systemctl is-enabled user@.service 2>/dev/null)" == "masked" ]]; then
        if sudo -n systemctl unmask user@.service >/dev/null 2>&1; then
            echo -e "${GREEN}  ✓ user@.service unmasked${NC}"
        else
            session_ok=0
            echo -e "${YELLOW}  user@.service is masked (old bootstrap); root is needed to unmask.${NC}"
            echo -e "${YELLOW}  From Windows PowerShell, run:${NC}"
            echo -e "${CYAN}    wsl -d Maude -u root -- systemctl unmask user@.service${NC}"
            echo -e "${CYAN}    wsl --terminate Maude${NC}"
            rc=1
        fi
    fi
    if ! dpkg -s dbus-user-session >/dev/null 2>&1; then
        echo -e "${YELLOW}  dbus-user-session is missing — installing via mom...${NC}"
        if mom install -y dbus-user-session 2>/dev/null \
           || sg mom -c "mom install -y dbus-user-session" 2>/dev/null; then
            echo -e "${GREEN}  ✓ dbus-user-session installed${NC}"
        else
            session_ok=0
            echo -e "${YELLOW}  ✗ could not install dbus-user-session${NC}"
            rc=1
        fi
    fi
    [[ $session_ok -eq 1 ]] && echo -e "${GREEN}  ✓ systemd user session OK${NC}"
    echo ""

    echo -e "${BOLD}Checking textual version (pin: >=8.2.4,<9)...${NC}"
    ensure_textual
    echo ""

    echo -e "${BOLD}Updating kanna-code...${NC}"
    if [[ "${JRC[kanna]:-1}" -eq 0 ]]; then
        echo -e "${GREEN}  ✓ kanna updated${NC}"
    else
        echo -e "${YELLOW}  ✗ kanna update failed${NC}"
        [[ -s "${JOUT[kanna]}" ]] && cat "${JOUT[kanna]}"
        rc=1
    fi
    echo ""

    echo -e "${BOLD}Updating Gemini CLI + skill...${NC}"
    if [[ -n "${JPID[gemini]:-}" ]]; then
        local gemini_out cli_line skill_line
        gemini_out=$(cat "${JOUT[gemini]}")
        cli_line=$(grep '^cli:'   <<< "$gemini_out" | cut -d: -f2-)
        skill_line=$(grep '^skill:' <<< "$gemini_out" | cut -d: -f2-)
        if [[ "${JRC[gemini]:-1}" -eq 0 ]]; then
            echo -e "${GREEN}  ✓ CLI:   ${cli_line}${NC}"
            echo -e "${GREEN}  ✓ skill: ${skill_line}${NC}"
        else
            [[ -n "$cli_line"   ]] && echo -e "${YELLOW}  CLI:   ${cli_line}${NC}"
            [[ -n "$skill_line" ]] && echo -e "${YELLOW}  skill: ${skill_line}${NC}"
            rc=1
        fi
        if [[ -s "${JERR[gemini]}" ]]; then
            while IFS= read -r _eline; do
                [[ -n "$_eline" ]] && echo -e "${YELLOW}  ! ${_eline}${NC}"
            done < "${JERR[gemini]}"
        fi
    else
        echo -e "${YELLOW}  gemini.sh library not loaded — skipping${NC}"
        rc=1
    fi
    echo ""

    # Reviewer CLIs — right below Gemini, same status-line protocol
    # (cli:/skill:/config: lines printed by each update_<tool> function).
    # These already ran (in parallel with everything above) — this loop
    # only reads back the captured output.
    local _rtool _rline
    for _rtool in codex opencode grok; do
        echo -e "${BOLD}Updating ${_rtool} CLI + skill...${NC}"
        if [[ -n "${JPID[$_rtool]:-}" ]]; then
            while IFS= read -r _rline; do
                [[ -z "$_rline" ]] && continue
                if [[ "${JRC[$_rtool]:-1}" -eq 0 ]]; then
                    echo -e "${GREEN}  ✓ ${_rline}${NC}"
                else
                    echo -e "${YELLOW}  ${_rline}${NC}"
                fi
            done < "${JOUT[$_rtool]}"
            if [[ -s "${JERR[$_rtool]}" ]]; then
                while IFS= read -r _eline; do
                    [[ -n "$_eline" ]] && echo -e "${YELLOW}  ! ${_eline}${NC}"
                done < "${JERR[$_rtool]}"
            fi
            [[ "${JRC[$_rtool]:-1}" -ne 0 ]] && rc=1
        else
            echo -e "${YELLOW}  ${_rtool}.sh library not loaded — skipping${NC}"
            rc=1
        fi
        echo ""
    done
    unset _rtool

    echo -e "${BOLD}Refreshing tool symlinks (bun, kanna, node, npm, npx, python, pip)...${NC}"
    ensure_tool_symlinks
    echo -e "${GREEN}  ✓ ~/.local/bin symlinks updated${NC}"
    echo ""

    echo -e "${BOLD}Upgrading Ubuntu packages (mom upgrade -y)...${NC}"
    if command -v mom >/dev/null 2>&1; then
        # Upgrading systemd in place strands the running user manager: its
        # executor helpers vanish from disk, the session dies unkillable on
        # the drvfs mount, and every cold start then fails with "Failed to
        # start the systemd user session" until the WSL VM is restarted.
        # Snapshot the version so we can warn when that restart is needed.
        local systemd_before systemd_after
        systemd_before=$(dpkg-query -W -f='${Version}' systemd 2>/dev/null)
        local upgraded=0
        # mom is setuid root but requires the caller to be in the 'mom' group.
        # Group membership only takes effect on next login, so if the user
        # was just added we may need to fall back to `sg mom -c '...'`.
        local mom_ver; mom_ver=$(mom --version 2>/dev/null | grep -oP '\d+\.\d+\.\d+' | head -1)
        if [[ -z "$mom_ver" ]] || ! dpkg --compare-versions "$mom_ver" ge "0.2.20"; then
            echo -e "${YELLOW}  mom ${mom_ver:-unknown} is older than v0.2.20 — skipping (run: mom install -y mom-inst to upgrade mom itself)${NC}"
        elif id -nG "$USER" | grep -qw mom; then
            if mom upgrade -y; then
                echo -e "${GREEN}  ✓ Ubuntu packages upgraded${NC}"
                upgraded=1
            else
                echo -e "${YELLOW}  ✗ mom upgrade failed${NC}"
                rc=1
            fi
        elif getent group mom | grep -qw "$USER"; then
            # In the group on disk but current shell hasn't picked it up.
            if sg mom -c "mom upgrade -y"; then
                echo -e "${GREEN}  ✓ Ubuntu packages upgraded (via sg)${NC}"
                upgraded=1
            else
                echo -e "${YELLOW}  ✗ mom upgrade failed${NC}"
                rc=1
            fi
        else
            echo -e "${YELLOW}  $USER is not in the 'mom' group; cannot run mom upgrade.${NC}"
            echo -e "${YELLOW}  Ask an admin to: sudo usermod -aG mom $USER && newgrp mom${NC}"
            rc=1
        fi
        if [[ $upgraded -eq 1 ]]; then
            systemd_after=$(dpkg-query -W -f='${Version}' systemd 2>/dev/null)
            if [[ -n "$systemd_before" && "$systemd_before" != "$systemd_after" ]]; then
                echo ""
                echo -e "${YELLOW}  systemd was upgraded ($systemd_before → $systemd_after).${NC}"
                echo -e "${YELLOW}  Restart the WSL VM soon or the next cold start will fail with${NC}"
                echo -e "${YELLOW}  'Failed to start the systemd user session'. From Windows PowerShell:${NC}"
                echo -e "${CYAN}    wsl --shutdown${NC}"
            fi
        fi
    else
        echo -e "${YELLOW}  mom is not installed; skipping${NC}"
        rc=1
    fi
    echo ""

    echo -e "${BOLD}Updating Anthropic skills...${NC}"
    if [[ -n "${JPID[skills]:-}" ]]; then
        if [[ "${JRC[skills]:-1}" -eq 0 ]]; then
            local count; count=$(cat "${JOUT[skills]}")
            echo -e "${GREEN}  ✓ ${count:-0} skills updated${NC}"
        else
            echo -e "${YELLOW}  ✗ could not clone skills repo — skipping${NC}"
            rc=1
        fi
        if [[ -s "${JERR[skills]}" ]]; then
            while IFS= read -r _eline; do
                [[ -n "$_eline" ]] && echo -e "${YELLOW}  ! ${_eline}${NC}"
            done < "${JERR[skills]}"
        fi
    else
        echo -e "${YELLOW}  update-skills.sh library not loaded — skipping${NC}"
        rc=1
    fi
    echo ""

    # Skills (gemini + Anthropic) are scanned only when Claude Code starts a
    # NEW session. The maude CLI and the TUI's Open Project both use
    # `claude --continue`, which resumes the prior session and won't see
    # freshly installed/updated skills — so point the user at a fresh start.
    echo -e "${CYAN}Note: new/updated skills load only in a fresh Claude session.${NC}"
    echo -e "${CYAN}  A resumed 'claude --continue' won't see them. To pick them up:${NC}"
    echo -e "${CYAN}  • TUI: tick 'Clear context (no history)' when opening a project, or${NC}"
    echo -e "${CYAN}  • shell: run 'claude opus' (without --continue) once.${NC}"
    echo ""

    # Write version stamp so the TUI can display it.
    # Try git first (dev machines), then the GitHub API (installed distros).
    local ver_stamp="$HOME/.local/share/maude/version"
    local cur_ver
    cur_ver=$(git -C "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" \
        describe --tags --always 2>/dev/null || true)
    if [[ -z "$cur_ver" ]]; then
        cur_ver=$(curl -fsSL --max-time 5 \
            "https://api.github.com/repos/dirkpetersen/maude/commits/main" \
            2>/dev/null | python3 -c \
            "import sys,json; d=json.load(sys.stdin); print(d['sha'][:7])" \
            2>/dev/null || true)
    fi
    mkdir -p "$(dirname "$ver_stamp")"
    printf '%s\n' "${cur_ver:-dev}" > "$ver_stamp"
    echo -e "${GREEN}maude version: ${cur_ver:-dev}${NC}"
    echo ""

    if [[ $rc -eq 0 ]]; then
        echo -e "${GREEN}All updates complete.${NC}"
    else
        echo -e "${YELLOW}Updates finished with one or more skipped/failed steps.${NC}"
    fi

    # Clean up the per-job capture files (individual files, never a dir).
    [[ ${#JOUT[@]} -gt 0 ]] && rm -f "${JOUT[@]}"
    [[ ${#JERR[@]} -gt 0 ]] && rm -f "${JERR[@]}"
    return $rc
}

# ── Launch the Git Setup Wizard (standalone) ─────────────────────────
launch_setup_git() {
    ensure_textual
    if [[ ! -f "$MAUDE_PY" ]]; then
        echo -e "${CYAN}Downloading maude TUI...${NC}"
        mkdir -p "$(dirname "$MAUDE_PY")"
        curl -fsSL "${MAUDE_PY_URL}?cache=$(date +%s)" -o "$MAUDE_PY" || {
            echo -e "${RED}Error: could not download maude.py${NC}" >&2
            exit 1
        }
    fi
    python3 "$MAUDE_PY" --github
}

# ── Launch kanna web UI ───────────────────────────────────────────────
# Return 0 if any LLM credentials are configured, 1 otherwise.
have_credentials() {
    [[ -n "${ANTHROPIC_FOUNDRY_API_KEY:-}" ]] && return 0
    [[ -n "${ANTHROPIC_API_KEY:-}" ]]         && return 0
    [[ -s "$HOME/.aws/credentials" ]]         && return 0
    [[ -s "$HOME/.azure/clauderc" ]]          && return 0
    return 1
}

launch_web() {
    # Refuse to launch without credentials — kanna can't function without them.
    if ! have_credentials; then
        echo "" >&2
        echo -e "${RED}No LLM credentials found.${NC}" >&2
        echo "" >&2
        echo "Configure one of the following before launching the Web UI:" >&2
        echo "  ANTHROPIC_API_KEY              environment variable" >&2
        echo "  ANTHROPIC_FOUNDRY_API_KEY      environment variable" >&2
        echo "  ~/.aws/credentials             AWS Bedrock" >&2
        echo "  ~/.azure/clauderc              Azure / Foundry exports" >&2
        echo "" >&2
        echo "Tip: launch the TUI ('maude tui') and use 'Set Credentials'." >&2
        echo "" >&2
        exit 1
    fi

    # Ensure bun/kanna/node/npm/npx symlinks are current — child processes
    # spawned by kanna don't source ~/.bashrc so they miss NVM/bun PATH setup.
    ensure_tool_symlinks

    # Install kanna-code via Bun if not present
    if ! command -v kanna >/dev/null 2>&1; then
        echo -e "${CYAN}Installing kanna-code...${NC}"
        bun install -g "$KANNA_PKG"
        ensure_tool_symlinks
    fi

    # Point kanna at the maude-installed claude wrapper, which sets the
    # appropriate auth env vars (Foundry/Azure/Bedrock/direct) per launch.
    # Falls back to plain `claude` on PATH if the wrapper is missing.
    if [[ -x "$HOME/bin/claude" ]]; then
        export CLAUDE_EXECUTABLE="$HOME/bin/claude"
    fi

    # kanna crashes if ~/.kanna is missing — guarantee the dir + seed defaults.
    mkdir -p "$HOME/.kanna/data" 2>/dev/null || true
    declare -F ensure_kanna_ready >/dev/null && ensure_kanna_ready

    echo -e "${GREEN}Launching kanna web UI...${NC}"
    echo -e "${YELLOW}Ctrl+click the URL below to open in your Windows browser${NC}"
    echo ""
    kanna --no-open
}

# ── Main ──────────────────────────────────────────────────────────────

# No arguments → show help
if [[ $# -eq 0 ]]; then
    show_help
    exit 0
fi

# Handle special commands
case "$1" in
    help|--help|-h)
        show_help
        exit 0
        ;;
    tui)
        launch_tui
        exit 0
        ;;
    web)
        launch_web
        exit 0
        ;;
    github)
        launch_setup_git
        exit 0
        ;;
    update)
        update_all
        exit $?
        ;;
    list|ls)
        list_projects
        exit 0
        ;;
    delete|rm)
        delete_project "$2"
        exit 0
        ;;
esac

# Project name = first argument
PROJECT_NAME="$1"

# Basic name validation
if [[ "$PROJECT_NAME" =~ [^a-zA-Z0-9._-] ]]; then
    echo -e "${RED}Error: Project name can only contain letters, numbers, dots, dashes, and underscores.${NC}" >&2
    echo "" >&2
    echo "Examples of valid names:  banana, my-app, test_01, v2.0" >&2
    exit 1
fi

PROJECT_PATH="$PROJECTS_DIR/$PROJECT_NAME"

# Create the Projects folder if it doesn't exist yet
mkdir -p "$PROJECTS_DIR"

# ── Ensure Claude Code is installed ──────────────────────────────────
if ! command -v claude >/dev/null 2>&1; then
    echo -e "${YELLOW}Claude Code is not installed.${NC}"
    echo ""
    read -r -p "Install it now? [Y/n] " answer
    case "$answer" in
        [Nn]*)
            echo -e "${RED}Cannot launch projects without Claude Code.${NC}"
            exit 1
            ;;
        *)
            echo "Installing Claude Code..."
            curl -fsSL https://claude.ai/install.sh | bash -s -- -y
            export PATH="$HOME/.claude/bin:$HOME/.local/bin:$PATH"
            if ! command -v claude >/dev/null 2>&1; then
                echo -e "${RED}Installation failed. Please install manually:${NC}"
                echo "  curl -fsSL https://claude.ai/install.sh | bash"
                exit 1
            fi
            echo -e "${GREEN}Claude Code installed.${NC}"
            echo ""
            ;;
    esac
fi

# ── Refresh Maude instructions ────────────────────────────────────────
# MAUDE.md is always overwritten with the latest sandbox instructions.
# CLAUDE.md is created only if missing — users can add their own content
# but must keep the MAUDE.md include line.
warn_if_suspicious_repo() {
    local project_path="$1"
    if [[ ! -d "$project_path/.git" ]]; then
        return
    fi
    if [[ -d "$project_path/.claude" ]] || [[ -f "$project_path/CLAUDE.md" ]]; then
        echo "" >&2
        echo -e "${YELLOW}⚠️  WARNING: This project contains .claude/ directory or CLAUDE.md file${NC}" >&2
        echo -e "${YELLOW}   Do not run untrusted code. These files can override sandbox rules.${NC}" >&2
        echo "" >&2
    fi
}

if ! declare -F refresh_claude_md >/dev/null; then
    # Fallback if lib/refresh-md.sh isn't available — best-effort, no caching.
    refresh_claude_md() {
        mkdir -p "$HOME/.claude"
        local tmp; tmp=$(mktemp)
        if curl -fsSL --max-time 10 "$GH_RAW/MAUDE.md" -o "$tmp" 2>/dev/null \
           && [[ -s "$tmp" ]] && head -1 "$tmp" | grep -q '^# Maude Sandbox'; then
            mv "$tmp" "$HOME/.claude/MAUDE.md"
        else
            rm -f "$tmp"
        fi
        if [[ ! -f "$HOME/.claude/CLAUDE.md" ]]; then
            curl -fsSL --max-time 10 "$GH_RAW/CLAUDE.template.md" \
                -o "$HOME/.claude/CLAUDE.md" 2>/dev/null || true
        fi
    }
fi

# ── Auto-update Claude Code once a week ──────────────────────────────
claude_maybe_update() {
    local stamp="$HOME/.claude/.last-update-check"
    local now
    now=$(date +%s)
    local last=0
    if [[ -f "$stamp" ]]; then
        last=$(cat "$stamp" 2>/dev/null || echo 0)
    fi
    local week=$((7 * 24 * 60 * 60))
    if [[ $((now - last)) -ge $week ]]; then
        echo -e "${CYAN}Checking for Claude Code updates...${NC}"
        claude update 2>/dev/null || true
        echo "$now" > "$stamp"
    fi
}

# ── Auto-run 'maude update' once a week ──────────────────────────────
# Resolve which `claude` to launch. Maude installs a wrapper at ~/bin/claude
# that sets auth env vars per provider; if the wrapper is broken (e.g. dead
# symlink from a partial dev-station install), fall back to the next claude
# on PATH so the user isn't stuck.
resolve_claude_cmd() {
    if [[ -x "$HOME/bin/claude" ]]; then
        # Quick smoke test — broken wrappers tend to fail trivially.
        if "$HOME/bin/claude" --version >/dev/null 2>&1; then
            printf '%s\n' "$HOME/bin/claude"
            return 0
        fi
        echo -e "${YELLOW}Warning: ~/bin/claude wrapper failed --version; falling back.${NC}" >&2
    fi
    local alt
    alt=$(PATH="${PATH//$HOME\/bin:/}" command -v claude 2>/dev/null)
    if [[ -n "$alt" ]]; then
        printf '%s\n' "$alt"
        return 0
    fi
    printf '%s\n' "claude"   # last resort, lets the shell error out cleanly
}

# Check if project already exists
if [[ -d "$PROJECT_PATH" ]]; then
    echo -e "${GREEN}Opening project:${NC} $PROJECT_NAME"
    warn_if_suspicious_repo "$PROJECT_PATH"
    claude_maybe_update
    refresh_claude_md
    cd "$PROJECT_PATH"
    echo ""
    CLAUDE_CMD=$(resolve_claude_cmd)
    "$CLAUDE_CMD" opus --continue || exec "$CLAUDE_CMD" opus
else
    # New project → create, git init, fresh start
    echo -e "${CYAN}Creating new project:${NC} $PROJECT_NAME"
    mkdir -p "$PROJECT_PATH"
    echo -e "${GREEN}  Created folder:${NC} $PROJECT_PATH"

    git -C "$PROJECT_PATH" init --quiet
    echo -e "${GREEN}  Initialized git repo${NC}"
    refresh_claude_md
    echo ""
    CLAUDE_CMD=$(resolve_claude_cmd)
    cd "$PROJECT_PATH" && exec "$CLAUDE_CMD" opus
fi
